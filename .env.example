# ─────────────────────────────────────────────────────────────────────────────
# research-opportunities-agent — environment template
# Copy this to `.env` and fill in real values. NEVER commit the real .env.
# All keys below are FREE-tier during the current discovery phase (zero spend).
# ─────────────────────────────────────────────────────────────────────────────

# --- Model providers (the agent's "brain") ---
# OpenRouter — used for the free fallback chain (Nemotron 550B, gpt-oss-120b, Hermes-3 405B).
# Get one at https://openrouter.ai/keys  (use only `:free` model slugs to stay zero-cost).
OPENROUTER_API_KEY=

# Google Gemini (AI Studio) — primary judge, free tier. Either name is read.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GOOGLE_API_KEY=

# --- Web search (discovery) ---
# Tavily — search + page extraction, free tier ~1,000 searches/mo.
# Get one at https://app.tavily.com
TAVILY_API_KEY=

# --- Delivery: Airtable (browsable record of finds) ---
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=Opportunities

# --- Delivery: email digest (Gmail SMTP, STARTTLS port 587) ---
# Use a Gmail *App Password* (16 chars), not your account password.
DIGEST_SMTP_USER=you@gmail.com
DIGEST_SMTP_APP_PASSWORD=
DIGEST_EMAIL_TO=you@gmail.com
